{
  "name": "operacion-filtracion",
  "version": "1.0.0",
  "private": true,
  "description": "Juego web multijugador de deducción social y thriller tecnológico contemporáneo (2026)",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:shared": "npm run build --workspace=shared",
    "build": "npm run build:shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend"
  },
  "keywords": [
    "mafia",
    "social-deduction",
    "cybersecurity",
    "socket.io",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
